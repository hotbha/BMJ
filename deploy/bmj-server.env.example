# BMJ backend — environment template for the VPS.
#
# Copy to /home/bmj/bmj/.env, fill in real values, then:
#   chmod 600 /home/bmj/bmj/.env
#
# NEVER commit the filled-in file. Only this template belongs in git.

# ---- Database (created by the compose stack) ----
DB_NAME=bmj_db
DB_USERNAME=bmj
# Generate with: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

# ---- Chargebee ----
# bookmyjuice-test for staging; switch to the production site only with
# production credentials (see RELEASE_CANDIDATE_CHECKLIST.md blocker B3).
CHARGEBEE_SITE=bookmyjuice-test
CHARGEBEE_API_KEY=CHANGE_ME_CHARGEBEE_API_KEY

# ---- Webhook Basic Auth (Chargebee → /api/webhooks/**) ----
# These must match the credentials configured on the Chargebee webhook endpoints.
# The server fails open with an empty password, so both values are mandatory.
WEBHOOK_USERNAME=bmj-webhooks
WEBHOOK_PASSWORD=CHANGE_ME_WEBHOOK_PASSWORD

# ---- Spring Security admin user ----
# Required: application.properties has no default for these.
ADMIN_USER=bmjadmin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
